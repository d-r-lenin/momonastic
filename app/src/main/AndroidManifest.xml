<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Declare the apps we want to be able to query -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <queries>
        <!-- This allows you to see all apps that can be launched -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <uses-permission
        android:name="com.android.launcher.permission.INSTALL_SHORTCUT"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.READ_SHORTCUTS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Momonastic">
        <activity
            android:name=".MomoLauncherActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Momonastic">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".GesterDetectionTest"
            android:exported="true"
            android:label="Gesture Detection Test">
        </activity>
        <activity
            android:name=".CameraActivity"
            android:exported="true" />
    </application>

</manifest>